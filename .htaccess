# Hostinger deploys the repository into public_html. Only mapped public files are served.
Options -Indexes
RewriteEngine On
# Block hidden paths (including .git) and traversal-like requests.
RewriteRule (^|/)\. - [F,END]
# Public pages and API endpoints. The backend and migration folders are never mapped.
RewriteRule ^robots\.txt$ public/robots.txt [END]
RewriteRule ^sitemap\.xml$ public/sitemap.php [END]
RewriteRule ^(?:index\.html|products\.html|product\.html)?$ public/catalogue.php [END]
RewriteRule ^admin$ /admin/ [R=308,END]
RewriteRule ^admin/(?:index\.php)?$ public/admin/index.php [END]
RewriteRule ^product-image/([0-9]{1,10})/[a-f0-9]{16}\.img$ public/image.php?id=$1 [END]
RewriteRule ^(enquiry\.php|image\.php|credits\.html|privacy\.html|logo\.png)$ public/$1 [END]
RewriteRule ^(images/[A-Za-z0-9_-]+\.(?:jpg|jpeg|png|webp|svg))$ public/$1 [END,NC]
RewriteRule ^ - [F,END]
